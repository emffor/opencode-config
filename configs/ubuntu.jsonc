{
  // Configuração do servidor Ubuntu: todos os MCPs abaixo executam no servidor.
  // Para ligar/desligar, edite mcps-ubuntu.jsonc e execute node apply-mcps.mjs.
  // O script gera opencode.jsonc e substitui os valores de disabled abaixo.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      // Review de pull requests do Bitbucket.
      "bitbucket-review": {
        "type": "local",
        "command": [
          "node",
          "--env-file=/home/administrador/xxx/mcp-suite/apps/bitbucket-mcp/.env",
          "/home/administrador/xxx/mcp-suite/apps/bitbucket-mcp/dist/index.js",
        ],
        "disabled": false,
      },
      // Mesmo coordenador HTTP do Hub; a ponte lê o token privado no Ubuntu.
      "pentest": {
        "type": "local",
        "command": [
          "/home/administrador/.nvm/versions/node/v24.22.1/bin/node",
          "/home/administrador/.config/opencode/pentest-http-bridge.mjs",
          "http://172.26.0.10:7320/mcp",
          "/home/administrador/.config/pentest-mcp/http-token",
        ],
        "disabled": false,
      },
      // Engenharia reversa.
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.7.0",
          "mcp",
        ],
        "disabled": false,
      },
    },
  },
}
