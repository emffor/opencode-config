{
  // Comandos e caminhos dos MCPs do Mac.
  // Para ligar/desligar, edite mcps-macos.jsonc e execute node apply-mcps.mjs.
  // O script gera opencode.jsonc e substitui os valores de disabled abaixo.
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./integrations/antigravity"],
  "mcp": {
    "servers": {
      // Bitbucket isolado no Ubuntu; VPN por padrão, sem credenciais no Mac.
      "bitbucket-review": {
        "type": "local",
        "command": [
          "ssh",
          "-T",
          "emfforserver-local",
          "/home/administrador/.config/opencode/node-with-nvm.sh",
          "node",
          "/home/administrador/xxx/mcp-suite/packages/network-gateway/dist/launcher.js",
          "/home/administrador/.config/mcp-suite/launchers/bitbucket.json",
        ],
        "disabled": false,
      },
      // Bitbucket executado no servidor via SSH (alternativa desabilitada).
      "bitbucket-review-emfforserver": {
        "type": "local",
        "command": [
          "ssh",
          "-T",
          "emfforserver-local",
          "/home/administrador/.config/opencode/node-with-nvm.sh",
          "node",
          "/home/administrador/xxx/mcp-suite/packages/network-gateway/dist/launcher.js",
          "/home/administrador/.config/mcp-suite/launchers/bitbucket.json",
        ],
        "disabled": true,
      },
      // Ponte SSH para o mesmo coordenador HTTP do Hub. Token permanece no Ubuntu.
      "pentest-mcp-emfforserver": {
        "type": "local",
        "command": [
          "ssh",
          "-T",
          "emfforserver-local",
          "/home/administrador/.config/opencode/node-with-nvm.sh",
          "node",
          "/home/administrador/.config/opencode/pentest-http-bridge.mjs",
          "http://172.26.0.10:7320/mcp",
          "/home/administrador/.config/pentest-mcp/http-token",
        ],
        "disabled": false,
      },
      // Engenharia reversa executada no Mac.
      "rea": {
        "type": "local",
        "command": ["fnm", "exec", "--using=default", "npx", "-y", "rea-agents@6.7.0", "mcp"],
        "disabled": false,
      },
      // Engenharia reversa executada no servidor via SSH.
      "rea-emfforserver": {
        "type": "local",
        "command": [
          "ssh",
          "-T",
          "emfforserver-local",
          "/home/administrador/.config/opencode/node-with-nvm.sh",
          "node",
          "/home/administrador/.local/share/opencode/mcp/rea/node_modules/rea-agents/scripts/rea.mjs",
          "mcp",
        ],
        "timeout": {
          "startup": 60000,
          "catalog": 60000,
        },
        "disabled": false,
      },
    },
  },
}
